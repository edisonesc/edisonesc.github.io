---
/**
 * Printable CV, rendered from the same collections as the site.
 * scripts/build-cv.mjs prints this page to dist/cv.pdf after `astro build`.
 */
// Static (non-variable) faces for the PDF: Chromium embeds variable fonts as Type 3,
// which many viewers render blurry and some ATS parsers misread.
import "@fontsource/cormorant-garamond/latin-300-italic.css";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-500.css";
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "@fontsource/cormorant-garamond/latin-700.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import { profile } from "../data/profile";
import Base from "../layouts/Base.astro";
import { cvBullets, getExperience, getProjects, getTechGroups } from "../lib/content";
import { formatRange } from "../lib/dates";

const [{ work, education, training }, projects, skillGroups] = await Promise.all([
	getExperience({ forCv: true }),
	getProjects({ forCv: true }),
	getTechGroups({ forCv: true }),
]);
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const contacts = [
	{ label: profile.email, href: `mailto:${profile.email}` },
	profile.phone && { label: profile.phone, href: `tel:${profile.phone.replace(/\s/g, "")}` },
	{ label: host(profile.siteUrl), href: profile.siteUrl },
	{ label: host(profile.links.github), href: profile.links.github },
	{ label: host(profile.links.linkedin), href: profile.links.linkedin },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title={`${profile.name} — CV`} description={`CV of ${profile.name}, ${profile.position}.`} printable>
	<nav class="toolbar" aria-label="CV actions">
		<a href="/">Back to site</a>
		<a href="/cv.pdf" download="Justin-Escabarte-CV.pdf" data-track="cv_download" class="primary">Download PDF</a>
	</nav>

	<article class="sheet">
		<header>
			<h1>{profile.name}</h1>
			<p class="role">{profile.headline}, {profile.location}</p>
			<ul class="contacts" role="list">
				{contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
			</ul>
		</header>

		<section>
			<h2>Summary</h2>
			<p>{profile.summary}</p>
		</section>

		<section>
			<h2>Experience</h2>
			{work.map(({ data: e }) => (
				<div class="entry">
					<div class="entry-head">
						<h3 class="job">{e.position}, {e.organization}</h3>
						<span class="dates">{formatRange(e.start, e.end)}</span>
					</div>
					{e.engagements.map((g) => (
						<div class="engagement">
							<p class="sub">{g.name} <span class="dates">{formatRange(g.start, g.end)}</span></p>
							{cvBullets(g).length > 0 && <ul>{cvBullets(g).map((h) => <li>{h}</li>)}</ul>}
							{g.groups.map((grp) => (
								<div class="group">
									<p class="group-title">{grp.title}</p>
									<ul>{cvBullets(grp).map((h) => <li>{h}</li>)}</ul>
								</div>
							))}
						</div>
					))}
					{cvBullets(e).length > 0 && <ul>{cvBullets(e).map((h) => <li>{h}</li>)}</ul>}
					{e.groups.map((grp) => (
						<div class="group">
							<p class="group-title">{grp.title}</p>
							<ul>{cvBullets(grp).map((h) => <li>{h}</li>)}</ul>
						</div>
					))}
				</div>
			))}
		</section>

		<section>
			<h2>Projects</h2>
			{projects.map((p) => (
				<div class="entry project">
					<div class="entry-head">
						<h3>{p.data.url ? <a href={p.data.url}>{p.data.name}</a> : p.data.name}</h3>
						<span class="dates">{formatRange(p.data.start, p.data.end)}</span>
					</div>
					<p>{p.data.description}</p>
					<p class="tech">{p.technologies.map((t) => t.data.name).join(", ")}</p>
				</div>
			))}
		</section>

		<section>
			<h2>Skills</h2>
			<dl class="skills">
				{skillGroups.map((g) => (<><dt>{g.label}</dt><dd>{g.items.map((t) => t.data.name).join(", ")}</dd></>))}
			</dl>
		</section>

		{training.length > 0 && (
			<section>
				<h2>Certifications and training</h2>
				{training.map(({ data: t }) => (
					<div class="entry-head">
						<h3>{t.organization}, {t.highlights.join(", ")}</h3>
						<span class="dates">{formatRange(t.start, t.end)}</span>
					</div>
				))}
			</section>
		)}

		<section>
			<h2>Education</h2>
			{education.map(({ data: e }) => (
				<div class="entry">
					<div class="entry-head">
						<h3>{e.organization}</h3>
						<span class="dates">{formatRange(e.start, e.end)}</span>
					</div>
					<p>{e.highlights.join(", ")}</p>
				</div>
			))}
		</section>
	</article>
</Base>

<style>
	/* Print-first CV on the shared tokens (forced light). Cormorant for headings, Inter for text. */
	@page { size: Letter; margin: 12mm 16mm; }

	:global(body) { background: var(--bg-offset); }
	.toolbar { display: flex; justify-content: center; gap: 0.75rem; padding: 1.25rem 1rem; }
	.toolbar a {
		font: 500 var(--t-label) / 1 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase;
		padding: 0.8rem 1.25rem; border: 1px solid var(--ink); color: var(--ink); text-decoration: none;
	}
	.toolbar a:hover, .toolbar .primary { background: var(--ink); color: var(--bg); }

	.sheet {
		--font-display: "Cormorant Garamond", Georgia, serif;
		--font-ui: "Inter", system-ui, sans-serif;
		max-width: 8.5in; margin: 0 auto 2.5rem; padding: 0.65in 0.75in;
		background: var(--bg); color: var(--ink-mid);
		font: 9.5pt/1.5 var(--font-ui);
		border-top: 4px solid var(--accent);
	}
	@media (max-width: 640px) { .sheet { padding: 1.5rem 1rem; } }

	h1 { font: italic 300 30pt/1 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
	.role { margin-top: 4pt; font: 400 13pt/1.3 var(--font-display); color: var(--ink); }
	.contacts { display: flex; flex-wrap: wrap; gap: 2pt 14pt; margin-top: 8pt; font-size: 8.5pt; }
	.contacts a { color: var(--ink-mid); text-decoration: none; }
	h3 a { color: inherit; text-decoration: none; }

	section { margin-top: 15pt; }
	h2 {
		font: 500 7.5pt/1 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink);
		padding-bottom: 5pt; margin-bottom: 8pt; border-bottom: 0.75pt solid var(--rule);
	}
	h3 { font: 500 12pt/1.25 var(--font-display); color: var(--ink); }
	h3.job { font-weight: 700; }
	.entry { margin-bottom: 10pt; }
	/* Let long roles flow across pages, but never strand a heading or split a bullet. */
	h2, h3, .entry-head, .sub { break-after: avoid; }
	li, .entry > p { break-inside: avoid; }
	.project { break-inside: avoid; }
	.entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
	.dates { flex-shrink: 0; font-size: 8pt; letter-spacing: 0.04em; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
	.sub { margin-top: 4pt; font: italic 500 10.5pt/1.3 var(--font-display); color: var(--ink); }
	.sub .dates { margin-left: 6pt; font-style: normal; font-family: var(--font-ui); }
	.engagement { margin-top: 2pt; }
	.group { margin-top: 4pt; }
	.group-title { font-size: 8pt; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); break-after: avoid; }
	ul { margin-top: 3pt; }
	.entry li { position: relative; padding-left: 10pt; margin-top: 2pt; }
	.entry li::before {
		content: ""; position: absolute; left: 0; top: 0.75em; width: 5pt; height: 0.75pt; background: var(--ink-soft);
	}
	.tech { font-size: 8pt; color: var(--ink-soft); margin-top: 2pt; }
	.skills { display: grid; grid-template-columns: max-content 1fr; gap: 3pt 14pt; }
	.skills dt { font-weight: 500; color: var(--ink); }

	@media print {
		/* White paper: the page margins print white, so a tinted sheet would stop short of them. */
		:global(html), :global(body) { background: #fff; }
		.toolbar { display: none; }
		.sheet { max-width: none; margin: 0; padding: 0; border-top: 0; background: #fff; line-height: 1.36; }
		/* Tracking makes PDF text extract as "E X P E R I E N C E", which ATS parsers can't match. */
		h2, .dates, .group-title { letter-spacing: normal; font-kerning: none; }
		section { margin-top: 12pt; }
		.entry { margin-bottom: 8pt; }
		.entry li { margin-top: 1pt; }
	}
</style>
