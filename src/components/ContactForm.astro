---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";
---

<form action={profile.formspree} method="POST" class="contact" data-contact>
	<div class="field">
		<label for="contact-email" class="label">Your email</label>
		<input id="contact-email" name="email" type="email" required autocomplete="email" />
	</div>
	<div class="field">
		<label for="contact-message" class="label">Message</label>
		<textarea id="contact-message" name="message" rows="6" required></textarea>
	</div>
	<!-- Honeypot: Formspree drops submissions that fill this in. -->
	<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
	<div class="flex flex-wrap items-center gap-6">
		<button type="submit" class="btn">Send message <Icon name="arrow-right" size={16} class="arrow" /></button>
		<p class="t-small" role="status" aria-live="polite" data-status></p>
	</div>
</form>

<style>
	.contact { display: grid; gap: var(--sp-3); max-width: var(--col-narrow); }
	.field { display: grid; gap: 0.5rem; }
	input, textarea {
		width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--rule); border-radius: 0;
		background: transparent; color: var(--ink); font: inherit; font-size: var(--t-body);
		transition: border-color var(--t-fast);
	}
	input:focus, textarea:focus { outline: none; border-color: var(--ink); }
	textarea { resize: vertical; }
</style>

<script>
	// Progressive enhancement: without JS the form still posts to Formspree normally.
	const form = document.querySelector<HTMLFormElement>("[data-contact]");
	const status = form?.querySelector<HTMLElement>("[data-status]");
	const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!status || !button) return;
		button.disabled = true;
		status.textContent = "Sending…";
		try {
			const res = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});
			if (res.ok) {
				const email = (form.elements.namedItem("email") as HTMLInputElement).value;
				form.reset();
				status.textContent = `Message sent. I'll reply to ${email}.`;
			} else {
				const body = await res.json().catch(() => null);
				const reason = body?.errors?.map((e: { message: string }) => e.message).join(", ");
				status.textContent = `Message not sent${reason ? `: ${reason}` : ""}. Check the fields and try again.`;
			}
		} catch {
			status.textContent = "Message not sent: no connection. Try again, or use the email address below.";
		} finally {
			button.disabled = false;
		}
	});
</script>
