---
import { profile } from "../data/profile";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	/** Hide the brand while the hero name (#name) is on screen, so the name isn't shown twice. */
	revealBrandOnScroll?: boolean;
}

const { revealBrandOnScroll = false } = Astro.props;

const nav = [
	{ href: "/#timeline", label: "Timeline" },
	{ href: "/#experience", label: "Experience" },
	{ href: "/#projects", label: "Projects" },
	{ href: "/#skills", label: "Skills" },
	{ href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
	<div class="wrap flex items-center justify-between gap-6">
		<a href="/" class="brand" data-reveal-on-scroll={revealBrandOnScroll || undefined}>{profile.shortName}</a>
		<nav aria-label="Sections" class="flex items-center gap-5">
			<ul role="list" class="hidden items-center gap-7 md:flex">
				{nav.map((n) => <li><a href={n.href} class="link-slide nav-link">{n.label}</a></li>)}
			</ul>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky; top: 0; z-index: 100;
		padding-block: 0.6rem;
		border-bottom: 1px solid var(--rule);
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		backdrop-filter: blur(8px);
	}
	.brand { font-family: var(--font-display); font-size: 1.125rem; line-height: 1; font-weight: 400; letter-spacing: 0.02em; text-decoration: none; color: var(--ink); }
	/* Hidden only once JS confirms the hero is in view; without JS the brand stays visible. */
	.brand { transition: opacity 0.3s ease, visibility 0.3s; }
	.brand.is-concealed { opacity: 0; visibility: hidden; }
	@media (prefers-reduced-motion: reduce) { .brand { transition: none; } }
	.nav-link { font-size: var(--t-small); letter-spacing: 0.04em; }
</style>

<script>
	const brand = document.querySelector<HTMLElement>(".brand[data-reveal-on-scroll]");
	const heroName = document.getElementById("name");
	if (brand && heroName) {
		new IntersectionObserver(
			([entry]) => brand.classList.toggle("is-concealed", entry.isIntersecting),
			{ rootMargin: "-64px 0px 0px 0px" },
		).observe(heroName);
	}
</script>
